{
  "name": "brass-style-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "npm run validate && next build",
    "start": "next start -p 3210",
    "validate": "node scripts/validate-content.mjs && node scripts/check-contrasto.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:peso": "node scripts/misura-peso.mjs http://127.0.0.1:3210/finiture 900 && node scripts/misura-peso.mjs http://127.0.0.1:3210/ 1200",
    "riavvia": "bash scripts/riavvia.sh"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
